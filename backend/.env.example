# Database Configuration
DATABASE_URL=sqlite:///./data/app.db

# Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-generated-fernet-key-here

# Application Settings
DEBUG=True
LOG_LEVEL=INFO

# Log every SQL statement. Off by default and independent of DEBUG / LOG_LEVEL.
# Set to true only when debugging queries. DB_ECHO=true is an accepted alias.
SQL_ECHO=false

# Debug Endpoints (Story P14-1.2)
# SECURITY WARNING: Only enable for development - exposes sensitive info!
# When enabled, /debug/ai-keys shows API key structure and /debug/network
# exposes internal network topology. NEVER enable in production.
DEBUG_ENDPOINTS_ENABLED=false

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Session cookies. Default SameSite=lax matches the same-site web app:
# the HTTPS frontend (LAN :3000 or https://agent.argusai.cc) proxies /api/v1,
# so the browser does not call the API on another site.
# Set COOKIE_SAMESITE=none only when the page and API are different sites
# (COOKIE_SECURE must stay true). Also list that page origin in CORS_ORIGINS.
# For plain HTTP, set COOKIE_SECURE=false.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Camera Settings
MAX_CAMERAS=1  # MVP limitation: single camera only
DEFAULT_FRAME_RATE=5

# Live stream and WebSocket connection bounds
# STREAM_MAX_CONCURRENT caps camera capture clients server-wide (default 10).
# WS_MAX_CONNECTIONS_PER_USER caps authenticated /ws and camera-stream sockets
# for one user (default 32). HomeKit HAP streaming is not counted.
# WS_MAX_CONNECTIONS_PER_CAMERA, when unset, follows STREAM_MAX_CONCURRENT.
STREAM_MAX_CONCURRENT=10
WS_MAX_CONNECTIONS_PER_USER=32

# SSL/HTTPS Configuration (Story P9-5.1)
# SSL is required for push notifications to work
SSL_ENABLED=false  # Enable HTTPS (requires valid certificates)
SSL_CERT_FILE=  # Path to SSL certificate file (PEM format), e.g., data/certs/cert.pem
SSL_KEY_FILE=  # Path to SSL private key file (PEM format), e.g., data/certs/key.pem
SSL_REDIRECT_HTTP=true  # Redirect HTTP to HTTPS when SSL is enabled
SSL_MIN_VERSION=TLSv1_2  # Minimum TLS version (TLSv1_2 or TLSv1_3)
SSL_PORT=443  # HTTPS port when SSL is enabled

# HomeKit Integration (Story P4-6.1)
HOMEKIT_ENABLED=false  # Enable HomeKit accessory server
HOMEKIT_PORT=51826  # HAP server port (default: 51826)
HOMEKIT_BRIDGE_NAME=ArgusAI  # Display name in Home app
HOMEKIT_MANUFACTURER=ArgusAI  # Manufacturer shown in Home app
HOMEKIT_PERSIST_DIR=data/homekit  # Directory for pairing state
# HOMEKIT_PINCODE=031-45-154  # Optional: Set specific pairing code (auto-generated if not set)

# Read-only MCP connector for assistant bots (issue #648)
# POST /api/v1/mcp; needs an API key with only read scopes, including read:mcp.
MCP_ENABLED=true  # Set false to turn the endpoint off (404)
MCP_RATE_LIMIT_PER_MINUTE=60  # Per-key ceiling; a lower limit on the key wins
MCP_THUMBNAIL_URL_TTL_SECONDS=600  # Lifetime of signed thumbnail links (30-3600)
# MCP_PUBLIC_BASE_URL=https://argusai.example.com  # Makes thumbnail links absolute

# Face recognizer: sface (default) or arcface (opt-in, user-supplied weights
# under a NON-COMMERCIAL licence; never downloaded by ArgusAI). See
# docs-site how-to-use/entities.md. After switching, run
# scripts/reembed_face_gallery.py --apply (references are per model).
# ARGUS_FACE_RECOGNIZER=arcface
# ARGUS_ARCFACE_MODEL_PATH=app/models/arcface/w600k_r50.onnx
# ARGUS_ARCFACE_SHA256=  # only for an export other than InsightFace buffalo_l
